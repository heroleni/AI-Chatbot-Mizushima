# Copia este archivo como .env y completa los valores.
# El SERVIDOR MCP no necesita claves. Estas son solo para el AGENTE (Mizushima).

# ── Modelos (OpenAI y/o Gemini) ──
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Con cuál arranca el agente: openai o google (dentro del agente se cambia con /provider)
PROVIDER=openai
# Nombre del modelo de cada proveedor (cámbialo si te dice que el modelo no existe)
OPENAI_MODEL=gpt-6-luna
GOOGLE_MODEL=gemini-3.8-flash

# ── Servidor al que se conecta el agente ──
# Vacío = lanza el servidor local. Con valor = Render, ngrok u otro PC.
# Ej: MCP_URL=https://mizushima-mcp.onrender.com
MCP_URL=

# ── Servidor MCP (solo si lo corres en HTTP) ──
# (MCP_TRANSPORT no va aquí: lo ponen las tareas de VS Code, la terminal o Render)
PORT=8000
# Solo si usas ngrok SIN --host-header=rewrite: tu dominio de ngrok
ALLOWED_HOSTS=
